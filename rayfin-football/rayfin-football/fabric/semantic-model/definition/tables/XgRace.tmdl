table XgRace

	column team
		dataType: string
		sourceProviderType: nvarchar(max)
		summarizeBy: none
		sourceColumn: team

		annotation SummarizationSetBy = User

	column minute
		dataType: int64
		formatString: 0
		sourceProviderType: int
		summarizeBy: none
		sourceColumn: minute

		annotation SummarizationSetBy = User

	column cum_xg
		dataType: double
		sourceProviderType: float
		summarizeBy: none
		sourceColumn: cum_xg

		annotation SummarizationSetBy = User

	column cum_goals
		dataType: int64
		formatString: 0
		sourceProviderType: bigint
		summarizeBy: none
		sourceColumn: cum_goals

		annotation SummarizationSetBy = User

	partition XgRace = m
		mode: directQuery
		source =
				let
				    Source = AzureDataExplorer.Contents("https://<eventhouse>.kusto.fabric.microsoft.com", "00000000-0000-0000-0000-000000000000", "XgRace(" & Number.ToText(Match_Id) & ")", [MaxRows=null, MaxSize=null, NoTruncate=null, AdditionalSetStatements=null])
				in
				    Source
