table Momentum

	column team
		dataType: string
		sourceProviderType: nvarchar(max)
		summarizeBy: none
		sourceColumn: team

		annotation SummarizationSetBy = User

	column minute
		dataType: int64
		formatString: 0
		sourceProviderType: int
		summarizeBy: none
		sourceColumn: minute

		annotation SummarizationSetBy = User

	column momentum
		dataType: double
		sourceProviderType: float
		summarizeBy: none
		sourceColumn: momentum

		annotation SummarizationSetBy = User

	partition Momentum = m
		mode: directQuery
		source =
				let
				    Source = AzureDataExplorer.Contents("https://<eventhouse>.kusto.fabric.microsoft.com", "00000000-0000-0000-0000-000000000000", "Momentum(" & Number.ToText(Match_Id) & ")", [MaxRows=null, MaxSize=null, NoTruncate=null, AdditionalSetStatements=null])
				in
				    Source
